<%- include('partials/head', { 
    title: 'Add Transaction', 
    description: 'Add buy or sell transaction to your portfolio',
    additionalStyles: '<link rel="stylesheet" href="/css/pages.css">'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container" style="max-width: 600px;">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-exchange-alt"></i> Add Transaction
                </h1>
    </div>
            
            <form action="/portfolio" method="post" id="transactionForm" class="form-body">
                <div class="form-group">
                    <label for="coinName" class="form-label">
                        <i class="fas fa-coins" style="color: var(--primary-color);"></i> Coin Name
                    </label>
                    <div style="display: flex; gap: 0;">
                        <input 
                            type="text" 
                            id="coinName" 
                            name="coinName" 
                            class="coin-name-input" 
                            list="coinList"
                            placeholder="Select or type coin (e.g., BTCUSDT)"
                            required
                            autocomplete="off"
                            style="width: 70%; border-radius: 5px 0 0 5px;"
                        >
                        <select 
                            name="ordertype" 
                            id="ordertype" 
                            class="order-type-select"
                            required
                            style="width: 30%; border-radius: 0 5px 5px 0; border-left: 2px solid var(--bg-darker);"
                        >
                    <option value="BUY">BUY</option>
                    <option value="SELL">SELL</option>
                </select>
            </div>
                    <datalist id="coinList"></datalist>
                    <small style="color: var(--text-muted); font-size: 0.85rem; display: block; margin-top: 5px;">
                        Type to search or select from list
                    </small>
                </div>
                
                <div class="form-group">
                    <label for="price" class="form-label">
                        <i class="fas fa-dollar-sign" style="color: var(--primary-color);"></i> Price per Unit
                    </label>
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <span id="priceSymbol" style="color: var(--primary-color); font-weight: bold; display: none;">$</span>
                        <input 
                            type="number" 
                            id="price" 
                            name="price" 
                            class="form-number-input" 
                            placeholder="Enter price or click to fetch"
                            step="any"
                            required
                            onclick="fetchPrice()"
                            style="flex: 1;"
                        >
                        <button 
                            type="button" 
                            onclick="fetchPrice()" 
                            class="btn btn-secondary"
                            style="padding: 8px 15px;"
                            title="Fetch current price from Binance"
                        >
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="units" class="form-label">
                        <i class="fas fa-calculator" style="color: var(--primary-color);"></i> Units/Quantity
                    </label>
                    <input 
                        type="number" 
                        id="units" 
                        name="units" 
                        class="form-number-input" 
                        placeholder="Enter quantity"
                        step="any"
                        required
                        onkeyup="calculateTotal()"
                        onkeydown="calculateTotal()"
                    >
                </div>
                
                <div class="form-group">
                    <label for="totals" class="form-label">
                        <i class="fas fa-money-bill-wave" style="color: var(--primary-color);"></i> Total Cost
                    </label>
                    <div style="display: flex; align-items: center; gap: 5px;">
                        <span id="totalSymbol" style="color: var(--primary-color); font-weight: bold; display: none;">$</span>
                        <input 
                            type="number" 
                            id="totals" 
                            name="totals" 
                            class="form-number-input" 
                            placeholder="Auto-calculated"
                            step="any"
                            required
                            readonly
                            style="flex: 1; background-color: var(--bg-darker);"
                        >
                    </div>
                </div>
                
                <div class="btns" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 25px;">
                    <button type="reset" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> Clear
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> Add Transaction
                    </button>
                </div>
            </form>
            </div>
        
        <div style="text-align: center; margin-top: 20px;">
            <a href="/funding" class="btn btn-success" style="text-decoration: none;">
                <i class="fas fa-wallet"></i> Funding Management
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts', { 
        additionalScripts: '<script src="/js/coins.js"></script>' 
    }) %>

    <script>
        // Initialize coin datalist on page load
        document.addEventListener('DOMContentLoaded', function() {
            initCoinDatalist('coinList');
        });
        
        // Number input validation
        function onlyNumberKey(evt) {
            const ASCIICode = (evt.which) ? evt.which : evt.keyCode;
            if (ASCIICode == 46) return true; // Allow decimal point
            else if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57)) return false;
            return true;
        }

        // Fetch price from Binance API
        async function fetchPrice() {
            const coinName = document.getElementById('coinName').value.trim().toUpperCase();
            const priceInput = document.getElementById('price');
            const symbolSpan = document.getElementById('priceSymbol');
            const totalSymbol = document.getElementById('totalSymbol');
            
            if (!coinName) {
                Swal.fire({
                    title: 'Coin Name Required!',
                    text: 'Please enter or select a coin name first.',
                    icon: 'warning',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return;
            }
            
            if (!navigator.onLine) {
                Swal.fire({
                    title: 'Offline!',
                    text: 'Please connect to the internet to fetch prices.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return;
            }
            
            try {
                // Show loading
                priceInput.disabled = true;
                priceInput.value = 'Fetching...';
                
                const price = await getCoinPrice(coinName);
                
                if (price && price > 0) {
                    priceInput.value = price;
                    symbolSpan.style.display = 'inline';
                    totalSymbol.style.display = 'inline';
                    symbolSpan.textContent = '$';
                    totalSymbol.textContent = '$';
                    
                    // Recalculate total if units are entered
                    calculateTotal();
                } else {
                    throw new Error('Invalid price received');
                }
            } catch (error) {
                Swal.fire({
                    title: 'Price Not Found!',
                    text: `Could not fetch price for ${coinName}. Please enter manually.`,
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                priceInput.value = '';
            } finally {
                priceInput.disabled = false;
            }
        }
        
        // Calculate total cost
        function calculateTotal() {
            const price = parseFloat(document.getElementById('price').value) || 0;
            const units = parseFloat(document.getElementById('units').value) || 0;
            const total = price * units;
            
            if (total > 0) {
                const totalInput = document.getElementById('totals');
                if (total < 0.0001) {
                    totalInput.value = total.toFixed(8);
                } else {
                    totalInput.value = total.toFixed(2);
                }
            }
        }
        
        // Auto-calculate on price change
        document.getElementById('price').addEventListener('input', calculateTotal);
        
        // Form validation
        document.getElementById('transactionForm').addEventListener('submit', function(e) {
            const coinName = document.getElementById('coinName').value.trim();
            const price = parseFloat(document.getElementById('price').value);
            const units = parseFloat(document.getElementById('units').value);
            const total = parseFloat(document.getElementById('totals').value);
            
            if (!coinName) {
                e.preventDefault();
                Swal.fire({
                    title: 'Coin Name Required!',
                    text: 'Please select or enter a coin name.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
            
            if (!price || price <= 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid Price!',
                    text: 'Please enter a valid price.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
            
            if (!units || units <= 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid Units!',
                    text: 'Please enter a valid quantity.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
            
            if (!total || total <= 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid Total!',
                    text: 'Total cost must be greater than 0.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
        });
    </script>
</body>
</html>
