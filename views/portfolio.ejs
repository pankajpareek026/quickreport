<%- include('partials/head', { title: 'Add Transaction' , description: 'Add a new trade to your portfolio' ,
    additionalStyles: '<link rel="stylesheet" href="/css/auth.css"><link rel="stylesheet" href="/css/dashboard.css">' })
    %>

    <style>
        .portfolio-container {
            min-height: calc(100vh - 80px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 40px;
        }

        .glass-form-card {
            width: 100%;
            max-width: 550px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .form-header h2 {
            color: var(--text-primary);
            font-size: 1.8rem;
            margin-bottom: 5px;
            text-align: center;
        }

        .form-header p {
            color: var(--text-secondary);
            text-align: center;
            margin-bottom: 30px;
        }

        .input-row {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .input-group {
            margin-bottom: 25px;
            flex: 1;
        }

        .input-group label {
            display: block;
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .premium-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 18px;
            color: var(--text-primary);
            font-size: 1rem;
            transition: var(--transition);
            outline: none;
        }

        .premium-input:focus {
            border-color: var(--primary-color);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 4px rgba(248, 134, 5, 0.1);
        }

        select.premium-input {
            background: #201f1f;
            cursor: pointer;
        }

        select.premium-input option {
            background: #201f1f;
            color: #ffffff;
            padding: 10px;
        }

        select.premium-input option:hover,
        select.premium-input option:checked {
            background: var(--primary-color);
            color: #ffffff;
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .btn-premium {
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 1.05rem;
        }

        .btn-save {
            background: var(--primary-color);
            color: white;
        }

        .btn-save:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
        }
    </style>

    <body>
        <%- include('partials/navbar', { isAuthenticated: true }) %>

            <div class="portfolio-container">
                <div class="glass-form-card">
                    <div class="form-header">
                        <h2><i class="fas fa-plus-circle" style="color: var(--primary-color); margin-right: 10px;"></i>
                            Add Asset</h2>
                        <p>Record your buy or sell transactions</p>
                    </div>

                    <form action="/portfolio" method="post" id="transactionForm">
                        <div class="input-row">
                            <div class="input-group" style="flex: 2;">
                                <label>Coin / Symbol</label>
                                <input type="text" id="coinName" name="coinName" class="premium-input" list="coinList"
                                    placeholder="e.g. bitcoin" required autocomplete="off">
                                <datalist id="coinList"></datalist>
                            </div>
                            <div class="input-group" style="flex: 1;">
                                <label>Order Type</label>
                                <select name="ordertype" id="ordertype" class="premium-input">
                                    <option value="BUY">BUY</option>
                                    <option value="SELL">SELL</option>
                                </select>
                            </div>
                        </div>

                        <div class="input-group">
                            <label>Price per Coin (USD)</label>
                            <div style="position: relative;">
                                <input type="number" id="price" name="price" class="premium-input" placeholder="0.00"
                                    step="any" required>
                                <button type="button" onclick="fetchPrice()"
                                    style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: var(--primary-color); border: none; border-radius: 8px; color: white; padding: 6px 10px; cursor: pointer;">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                        </div>

                        <div class="input-group">
                            <label>Units / Quantity</label>
                            <input type="number" id="units" name="units" class="premium-input" placeholder="0.1234"
                                step="any" required oninput="calculateTotal()">
                        </div>

                        <div class="input-group">
                            <label>Total Investment</label>
                            <input type="number" id="totals" name="totals" class="premium-input" placeholder="0.00"
                                step="any" required readonly style="background: rgba(0,0,0,0.2); cursor: not-allowed;">
                        </div>

                        <div class="btn-group">
                            <a href="/dash-bord" class="btn-premium btn-cancel">Cancel</a>
                            <button type="submit" class="btn-premium btn-save">
                                <i class="fas fa-check"></i> Record Trade
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts', { additionalScripts: '<script src="/js/coins.js"></script>' }) %>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            initCoinDatalist('coinList');
                        });

                        async function fetchPrice() {
                            const coinName = document.getElementById('coinName').value.trim();
                            const priceInput = document.getElementById('price');

                            if (!coinName) {
                                Swal.fire({
                                    title: 'Coin Name Needed',
                                    text: 'Please enter a coin ID first (e.g., bitcoin)',
                                    icon: 'info',
                                    confirmButtonColor: 'var(--primary-color)'
                                });
                                return;
                            }

                            try {
                                priceInput.style.opacity = '0.5';
                                const price = await getCoinPrice(coinName);
                                if (price) {
                                    priceInput.value = price;
                                    calculateTotal();
                                }
                            } catch (e) {
                                Swal.fire({
                                    title: 'Price Fetch Failed',
                                    text: 'Make sure you entered the correct Coin ID (e.g., cardano, solana)',
                                    icon: 'error',
                                    confirmButtonColor: 'var(--primary-color)'
                                });
                            } finally {
                                priceInput.style.opacity = '1';
                            }
                        }

                        function calculateTotal() {
                            const price = parseFloat(document.getElementById('price').value) || 0;
                            const units = parseFloat(document.getElementById('units').value) || 0;
                            const totalInput = document.getElementById('totals');
                            totalInput.value = (price * units).toFixed(2);
                        }
                    </script>
    </body>

    </html>