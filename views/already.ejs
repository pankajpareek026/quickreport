<%- include('partials/head', { title: 'Already Registered', description: 'Account already exists' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-warning">
                    <i class="fas fa-exclamation-triangle"></i> Account Already Exists
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    This email or username is already registered.
                </p>
                <p style="font-size: 0.9rem; margin: 20px 0; color: var(--text-muted);">
                    Please try logging in or use a different email/username to register.
                </p>
                <div class="button-group" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center;">
                    <a href="/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Go to Login
                    </a>
                    <a href="/register" class="btn btn-secondary">
                        <i class="fas fa-user-plus"></i> Register Again
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
