<%- include('partials/head', { 
    title: 'Crypto News', 
    description: 'Latest cryptocurrency news and updates',
    additionalStyles: '<link rel="stylesheet" href="/css/pages.css">'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div style="margin-top: 100px; padding: 20px;">
        <h1 style="text-align: center; color: var(--primary-color); font-size: 2.5rem; margin-bottom: 50px;">
            <i class="fas fa-newspaper"></i> Top Crypto News
        </h1>
        
        <section id="newsSection" style="display: grid; gap: 30px; max-width: 1200px; margin: 0 auto;">
            <%- include('components/loading') %>
        </section>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        const newsSection = document.getElementById('newsSection');
        
        const fetchNews = async () => {
            try {
                const response = await fetch('https://newsapi.org/v2/everything?q=bitcoin&from=today&language=en&sortBy=publishedAt&apiKey=a40e70ce49b34f59a1ca7648e187cdba');
                const data = await response.json();
                
                if (data.articles && data.articles.length > 0) {
                    newsSection.innerHTML = '';
                    
                    data.articles.forEach(article => {
                        const newsCard = document.createElement('div');
                        newsCard.className = 'news-item';
                        newsCard.innerHTML = `
                            <a href="${article.url}" target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit;">
                                ${article.urlToImage ? `
                                    <img src="${article.urlToImage}" 
                                         alt="${article.title}" 
                                         class="img" 
                                         style="width: 100%; height: 300px; object-fit: cover; border-radius: 15px; margin-bottom: 15px; cursor: pointer;"
                                         onerror="this.src='https://via.placeholder.com/600x300?text=No+Image'">
                                ` : ''}
                                <div class="news-title" style="color: var(--text-primary); text-align: center; font-size: 1.2rem; padding: 10px; border-radius: 15px; margin: 0; font-weight: 600; transition: var(--transition);">
                                    ${article.title}
                                </div>
                                <p style="color: var(--text-muted); text-align: center; font-size: 0.9rem; margin-top: 10px;">
                                    Source: ${article.source.name}
                                </p>
                            </a>
                        `;
                        
                        // Add hover effect
                        newsCard.querySelector('.news-title').addEventListener('mouseenter', function() {
                            this.style.color = 'var(--primary-color)';
                        });
                        newsCard.querySelector('.news-title').addEventListener('mouseleave', function() {
                            this.style.color = 'var(--text-primary)';
                        });
                        
                        newsSection.appendChild(newsCard);
                    });
                } else {
                    newsSection.innerHTML = '<div class="alert alert-warning">No news articles found.</div>';
                }
            } catch (error) {
                console.error('Error fetching news:', error);
                newsSection.innerHTML = '<div class="alert alert-error">Failed to load news. Please try again later.</div>';
            }
        };
        
        fetchNews();
    </script>
    
    <style>
        .news-item {
            background-color: var(--bg-dark);
            border-radius: 15px;
            box-shadow: var(--shadow);
            padding: 20px;
            transition: var(--transition);
        }
        
        .news-item:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-lg);
        }
        
        .img {
            cursor: pointer;
        }
    </style>
</body>
</html>
