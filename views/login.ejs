<%- include('partials/head', { title: 'Login', description: 'Login to QuickReport' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="form-container">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-sign-in-alt"></i> Login
                </h1>
            </div>
            
            <form action="/login" method="post" id="loginForm" class="form-body">
                <div class="form-group">
                    <label for="usrName" class="form-label">
                        <i class="fas fa-user" style="color: var(--primary-color);"></i> Username or Email
                    </label>
                    <input 
                        type="text" 
                        id="usrName" 
                        name="usrName" 
                        class="form-input" 
                        placeholder="Enter your username or email"
                        required
                        autocomplete="username"
                    >
                </div>
                
                <div class="form-group">
                    <label for="Passlog" class="form-label">
                        <i class="fas fa-lock" style="color: var(--primary-color);"></i> Password
                    </label>
                    <input 
                        type="password" 
                        id="Passlog" 
                        name="Passlog" 
                        class="form-input" 
                        placeholder="Enter your password"
                        required
                        autocomplete="current-password"
                    >
                </div>
                
                <div class="form-group" style="margin-top: 25px;">
                    <button type="submit" class="btn btn-primary" style="width: 100%;">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </button>
                </div>
                
                <div class="text-center" style="margin-top: 20px;">
                    <p style="color: var(--text-secondary);">
                        Don't have an account? 
                        <a href="/register" style="color: var(--primary-color); font-weight: 600;">
                            Register here
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
