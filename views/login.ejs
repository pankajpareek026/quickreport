<%- include('partials/head', { title: 'Login | QuickReport' ,
    description: 'Access your cryptocurrency portfolio dashboard.' ,
    additionalStyles: '<link rel="stylesheet" href="/css/auth.css">' }) %>

    <body>
        <%- include('partials/navbar', { isAuthenticated: false }) %>

            <div class="auth-page-wrapper">
                <div class="auth-card">
                    <div class="auth-header">
                        <i class="fas fa-user-shield"></i>
                        <h1>Welcome Back</h1>
                        <p>Log in to access your synchronized portfolio</p>
                    </div>

                    <form action="/login" method="post" id="loginForm" class="auth-body">
                        <div class="auth-group">
                            <label for="usrName" class="auth-label">
                                <i class="fas fa-user"></i> Username or Email
                            </label>
                            <div class="auth-input-wrapper">
                                <input type="text" id="usrName" name="usrName" class="auth-input"
                                    placeholder="your@email.com" required autocomplete="username">
                            </div>
                        </div>

                        <div class="auth-group">
                            <label for="Passlog" class="auth-label">
                                <i class="fas fa-lock"></i> Password
                            </label>
                            <div class="auth-input-wrapper">
                                <input type="password" id="Passlog" name="Passlog" class="auth-input"
                                    placeholder="••••••••" required autocomplete="current-password">
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary auth-btn-long">
                            Login to Dashboard
                        </button>

                        <div class="social-login-divider">Alternatively</div>

                        <div class="auth-footer">
                            <p class="auth-support-text">
                                Don't have an account yet?
                                <a href="/register">Create Secure Account</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>
    </body>

    </html>