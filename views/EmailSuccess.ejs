<%- include('partials/head', { title: 'Email Verified', description: 'Email verification successful' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> Email Verified!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    Your email address has been successfully verified.
                </p>
                <p style="font-size: 0.9rem; margin: 20px 0; color: var(--text-muted);">
                    You can now access all features of QuickReport.
                </p>
                <div class="button-group" style="margin-top: 30px;">
                    <a href="/dash-bord" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        // Auto-redirect to dashboard after 3 seconds
        setTimeout(() => {
            window.location.href = '/dash-bord';
        }, 3000);
    </script>
</body>
</html>
