<%- include('partials/head', { 
    title: 'About Us', 
    description: 'Learn about QuickReport - Cryptocurrency Portfolio Tracker'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="about-container">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-info-circle"></i> About QuickReport
                </h1>
            </div>
            
            <div class="card-body">
                <p style="color: var(--text-primary); font-size: 1.1rem; line-height: 1.8; text-align: justify; margin-bottom: 30px;">
                    QuickReport is a comprehensive cryptocurrency price and portfolio tracker. We provide real-time market data, 
                    market sentiment analysis, and the latest crypto news to help users manage their positions according to 
                    market fundamental sentiments.
                </p>
                
                <p style="color: var(--text-primary); font-size: 1.1rem; line-height: 1.8; text-align: justify; margin-bottom: 30px;">
                    Our portfolio management system allows users to track and add transactions manually or by uploading a 
                    transaction record file. Our system automatically fetches transactions from JSON or CSV files and adds 
                    them to the user's portfolio, making portfolio management seamless and efficient.
                </p>
                
                <div style="margin-top: 40px; padding-top: 30px; border-top: 2px solid var(--border-color);">
                    <h2 style="color: var(--primary-color); font-size: 2rem; font-weight: 100; text-align: center; margin-bottom: 30px;">
                        Our Data Sources
                    </h2>
                    
                    <div style="display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 30px; margin: 30px 0;">
                        <div style="text-align: center;">
                            <img alt="Binance.com" 
                                 title="Binance.com"
                                 src="https://www.logo.wine/a/logo/Binance/Binance-Logo.wine.svg"
                                 style="width: 200px; height: 150px; background-color: transparent; filter: brightness(0.9);">
                            <p style="color: var(--text-secondary); margin-top: 10px;">Binance</p>
                        </div>
                        
                        <div style="text-align: center;">
                            <img alt="CoinMarketCap" 
                                 title="CoinMarketCap"
                                 src="https://bankerdoge.com/wp-content/uploads/2021/08/CoinMarketCap_Logo2-296x300.png"
                                 style="width: 150px; height: 150px; background-color: transparent; filter: brightness(0.9);">
                            <p style="color: var(--text-secondary); margin-top: 10px;">CoinMarketCap</p>
                        </div>
                        
                        <div style="text-align: center;">
                            <img alt="CoinGecko" 
                                 title="CoinGecko"
                                 src="https://static.coingecko.com/s/coingecko-branding-guide-4f5245361f7a47478fa54c2c57808a9e05d31ac7ca498ab189a3827d6000e22b.png"
                                 style="width: 200px; height: 100px; background-color: transparent; filter: brightness(0.9);">
                            <p style="color: var(--text-secondary); margin-top: 10px;">CoinGecko</p>
                        </div>
                    </div>
                </div>
                
                <div class="alert alert-warning" style="margin-top: 40px;">
                    <i class="fas fa-exclamation-triangle"></i>
                    <strong style="color: var(--warning-color);">DISCLAIMER:</strong>
                    <p style="color: var(--text-primary); margin-top: 10px; line-height: 1.6;">
                        We are not responsible for all data information provided here because we are not the original source 
                        of these informations. All data is provided by third-party APIs. Please verify information from 
                        official sources before making investment decisions.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
