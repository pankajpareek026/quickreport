<%- include('partials/head', { 
    title: 'Funding Management', 
    description: 'Add deposit or withdrawal transactions',
    additionalStyles: '<link rel="stylesheet" href="/css/pages.css">'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container" style="max-width: 500px;">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-wallet"></i> Add Funding Transaction
                </h1>
            </div>
            
            <form action="/funding" method="post" id="fundingForm" class="form-body">
                <div class="form-group">
                    <label for="amount" class="form-label">
                        <i class="fas fa-dollar-sign" style="color: var(--primary-color);"></i> Amount
                    </label>
                    <input 
                        type="number" 
                        id="amount" 
                        name="amount" 
                        class="form-input" 
                        placeholder="Enter amount"
                        required
                        step="0.01"
                        min="0"
                        onkeypress="return onlyNumberKey(event)"
                    >
                </div>
                
                <div class="form-group">
                    <label for="type" class="form-label">
                        <i class="fas fa-exchange-alt" style="color: var(--primary-color);"></i> Transaction Type
                    </label>
                    <select name="type" id="type" class="form-select" required>
                        <option value="Deposit">Deposit</option>
                        <option value="withdraw">Withdrawal</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="Discription" class="form-label">
                        <i class="fas fa-comment" style="color: var(--primary-color);"></i> Description
                    </label>
                    <textarea 
                        id="Discription" 
                        name="Discription" 
                        class="form-input" 
                        rows="4"
                        placeholder="Enter description (e.g., from Bank of India)"
                        minlength="5"
                        maxlength="100"
                        required
                        style="resize: vertical;"
                    ></textarea>
                    <small style="color: var(--text-muted); font-size: 0.85rem;">
                        Minimum 5 characters, maximum 100 characters
                    </small>
                </div>
                
                <div class="form-group">
                    <label for="date" class="form-label">
                        <i class="fas fa-calendar" style="color: var(--primary-color);"></i> Date
                    </label>
                    <input 
                        type="date" 
                        id="date" 
                        name="date" 
                        class="form-input" 
                        required
                        max="<%= new Date().toISOString().split('T')[0] %>"
                    >
                </div>
                
                <div class="btns" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 25px;">
                    <button type="reset" class="btn btn-secondary">
                        <i class="fas fa-redo"></i> Clear
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check"></i> Submit
                    </button>
                </div>
            </form>
        </div>
        
        <div style="text-align: center; margin-top: 20px;">
            <a href="/portfolio" class="btn btn-success" style="text-decoration: none;">
                <i class="fas fa-exchange-alt"></i> Buy/Sell Transactions
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        function onlyNumberKey(evt) {
            var ASCIICode = (evt.which) ? evt.which : evt.keyCode;
            if (ASCIICode == 46) return true; // Allow decimal point
            else if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57)) return false;
            return true;
        }
        
        // Set default date to today
        document.getElementById('date').value = new Date().toISOString().split('T')[0];
        
        // Form validation
        document.getElementById('fundingForm').addEventListener('submit', function(e) {
            const amount = parseFloat(document.getElementById('amount').value);
            if (amount <= 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid Amount!',
                    text: 'Please enter a valid amount greater than 0.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
        });
    </script>
</body>
</html>
