<%- include('partials/head', { title: 'Error', description: 'An error occurred' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-error">
                    <i class="fas fa-exclamation-triangle"></i> Error
                </h1>
            </div>
            <div class="card-body">
                <p class="alert-message" style="font-size: 1.2rem; margin: 20px 0;">
                    <%= typeof message !== 'undefined' ? message : 'An unexpected error occurred' %>
                </p>
                <div class="button-group" style="margin-top: 30px;">
                    <a href="/login" class="btn btn-primary" style="margin-right: 10px;">
                        <i class="fas fa-sign-in-alt"></i> Go to Login
                    </a>
                    <a href="/register" class="btn btn-secondary">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>

    <script>
        // Auto-redirect after 5 seconds if on error page
        setTimeout(() => {
            if (window.location.pathname === '/error') {
                window.location.href = '/';
            }
        }, 5000);
    </script>
</body>
</html>
