<%- include('partials/head', { title: 'Transactions Added', description: 'File processed successfully' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> Transactions Added Successfully!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.2rem; margin: 20px 0; color: var(--primary-color);">
                    <strong><%= typeof result !== 'undefined' && result.affectedRows ? result.affectedRows : 0 %></strong> transactions have been added to your portfolio.
                </p>
                <div class="button-group" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center;">
                    <button onclick="window.location='/dash-bord'" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> Go to Dashboard
                    </button>
                    <button onclick="window.location='/'" class="btn btn-secondary">
                        <i class="fas fa-home"></i> Go Home
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        // Auto-redirect to dashboard after 3 seconds
        setTimeout(() => {
            window.location.href = '/dash-bord';
        }, 3000);
    </script>
</body>
</html>
