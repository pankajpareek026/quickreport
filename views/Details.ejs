<%- include('partials/head', { title: `Details | ${typeof CmcSymbol !=='undefined' ? CmcSymbol : 'Asset' }`,
    description: 'Transaction history and asset performance analytics' ,
    additionalStyles: '<link rel="stylesheet" href="/css/assetDetails.css"><script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>'
    }) %>

    <body>
        <%- include('partials/navbar', { isAuthenticated: true }) %>

            <div class="details-container">
                <% if (typeof results !=='undefined' && results && results.length> 0) { %>

                    <!-- Hero Asset Section -->
                    <div class="glass-card asset-header">
                        <div class="asset-identity">
                            <div class="asset-logo-container">
                                <% if (typeof ImageSrc !=='undefined' && ImageSrc) { %>
                                    <img src="<%= ImageSrc %>" alt="<%= CmcName %>">
                                    <% } else { %>
                                        <i class="fas fa-coins fa-2x" style="color: var(--primary-color);"></i>
                                        <% } %>
                            </div>
                            <div class="asset-titles">
                                <h1>
                                    <%= typeof CmcName !=='undefined' ? CmcName : Asset_Name %>
                                </h1>
                                <div class="asset-symbol">
                                    <%= typeof CmcSymbol !=='undefined' ? CmcSymbol : '' %> / USD
                                </div>
                            </div>
                        </div>

                        <div class="asset-price-info">
                            <div class="asset-price">
                                $<%= typeof CurrenPrice !=='undefined' ? parseFloat(CurrenPrice).toLocaleString('en-US',
                                    { minimumFractionDigits: 2, maximumFractionDigits: 6 }) : '0.00' %>
                            </div>
                            <div class="asset-change <%= ChangeIn24H >= 0 ? 'positive' : 'negative' %>">
                                <i class="fas fa-caret-<%= ChangeIn24H >= 0 ? 'up' : 'down' %>"></i>
                                <%= Math.abs(parseFloat(ChangeIn24H || 0)).toFixed(2) %>% (24h)
                            </div>
                        </div>
                    </div>

                    <!-- Intervals Row -->
                    <div class="glass-card intervals-card">
                        <div class="interval-box">
                            <div class="interval-label">7D</div>
                            <div class="interval-pct <%= ChangeIn7D >= 0 ? 'positive' : 'negative' %>">
                                <%= ChangeIn7D>= 0 ? '+' : '' %><%= parseFloat(ChangeIn7D || 0).toFixed(2) %>%
                            </div>
                        </div>
                        <div class="interval-box">
                            <div class="interval-label">30D</div>
                            <div class="interval-pct <%= ChangeIn30D >= 0 ? 'positive' : 'negative' %>">
                                <%= ChangeIn30D>= 0 ? '+' : '' %><%= parseFloat(ChangeIn30D || 0).toFixed(2) %>%
                            </div>
                        </div>
                        <div class="interval-box">
                            <div class="interval-label">60D</div>
                            <div class="interval-pct <%= ChangeIn60D >= 0 ? 'positive' : 'negative' %>">
                                <%= ChangeIn60D>= 0 ? '+' : '' %><%= parseFloat(ChangeIn60D || 0).toFixed(2) %>%
                            </div>
                        </div>
                        <div class="interval-box">
                            <div class="interval-label">90D</div>
                            <div class="interval-pct <%= ChangeIn90D >= 0 ? 'positive' : 'negative' %>">
                                <%= ChangeIn90D>= 0 ? '+' : '' %><%= parseFloat(ChangeIn90D || 0).toFixed(2) %>%
                            </div>
                        </div>
                    </div>

                    <!-- Chart Section -->
                    <div class="glass-card chart-card" style="margin-bottom: 30px; padding: 25px;">
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <h2
                                style="font-size: 1.1rem; color: var(--text-primary); display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-chart-area" style="color: var(--primary-color);"></i> Performance (7D)
                            </h2>
                            <div id="chart-status"
                                style="font-size: 0.8rem; color: var(--text-secondary); opacity: 0.7;">Fetching
                                historical data...</div>
                        </div>
                        <div id="assetChart" style="min-height: 250px;"></div>
                    </div>

                    <!-- Stats Grid -->
                    <div class="asset-stats-grid">
                        <div class="stat-item">
                            <div class="stat-label"><i class="fas fa-hand-holding-usd"></i> Invested</div>
                            <div class="stat-value">$<%= parseFloat(SumInvested || 0).toLocaleString() %>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label"><i class="fas fa-wallet"></i> Current Value</div>
                            <div class="stat-value">$<%= parseFloat(holding * CurrenPrice).toLocaleString(undefined,
                                    {minimumFractionDigits: 2, maximumFractionDigits: 2}) %>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label"><i class="fas fa-tag"></i> Avg. Price</div>
                            <div class="stat-value">$<%= parseFloat(Avp || 0).toLocaleString(undefined,
                                    {minimumFractionDigits: 2, maximumFractionDigits: 4}) %>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label"><i class="fas fa-cubes"></i> Holdings</div>
                            <div class="stat-value">
                                <%= parseFloat(holding || 0).toFixed(4) %>
                                    <%= CmcSymbol %>
                            </div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label"><i class="fas fa-chart-line"></i> Total P&L</div>
                            <div class="stat-value <%= TotalPNLP >= 0 ? 'positive' : 'negative' %>">
                                <%= TotalPNLP>= 0 ? '+' : '' %><%= parseFloat(TotalPNLP || 0).toFixed(2) %>%
                            </div>
                        </div>
                    </div>

                    <!-- Transactions List -->
                    <div class="glass-card">
                        <div class="transactions-header">
                            <h2><i class="fas fa-history" style="color: var(--primary-color);"></i> Trade History</h2>
                            <button class="btn-add-sm" onclick="showAddTransactionOptions()">
                                <i class="fas fa-plus-circle"></i> New Trade
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="premium-details-table">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Date</th>
                                        <th>Price</th>
                                        <th>Units</th>
                                        <th>Total</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% for(let i=0; i < results.length; i++) { %>
                                        <tr>
                                            <td>
                                                <span
                                                    class="order-badge <%= results[i].ORDER_TYPE === 'BUY' ? 'badge-buy' : 'badge-sell' %>">
                                                    <%= results[i].ORDER_TYPE %>
                                                </span>
                                            </td>
                                            <td style="color: var(--text-secondary); font-size: 0.85rem;">
                                                <%= results[i].DATE ? new
                                                    Date(results[i].DATE).toLocaleDateString('en-US', { day: '2-digit' ,
                                                    month: 'short' , year: 'numeric' }) : new
                                                    Date().toLocaleDateString() %>
                                            </td>
                                            <td style="font-family: 'Roboto Mono', monospace;">
                                                $<%= parseFloat(results[i].PRICE).toLocaleString() %>
                                            </td>
                                            <td style="font-family: 'Roboto Mono', monospace;">
                                                <%= parseFloat(Math.abs(results[i].UNITS)).toFixed(4) %>
                                            </td>
                                            <td style="font-family: 'Roboto Mono', monospace; font-weight: 600;">
                                                $<%= parseFloat(results[i].TOTAL_COST ||
                                                    results[i].SELL_COST).toLocaleString() %>
                                            </td>
                                            <td>
                                                <div class="detail-actions">
                                                    <a href="/update?id=<%= results[i].ID %>"
                                                        class="action-btn-circle edit" title="Edit Trade">
                                                        <i class="fas fa-pen"></i>
                                                    </a>
                                                    <button
                                                        onclick="confirmDelete('<%= results[i].ID %>', '<%= results[i].Coin_Name %>')"
                                                        class="action-btn-circle delete" title="Delete Trade">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <% } else { %>
                        <div class="glass-card" style="text-align: center; padding: 60px 20px;">
                            <i class="fas fa-search fa-4x"
                                style="color: var(--primary-color); opacity: 0.5; margin-bottom: 20px;"></i>
                            <h2 style="color: var(--text-primary);">No Transactions Found</h2>
                            <p style="color: var(--text-secondary); margin-bottom: 30px;">There are no recorded trades
                                for this asset yet.</p>
                            <a href="/portfolio" class="btn btn-primary">Add Your First Trade</a>
                        </div>
                        <% } %>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>

                    <script>
                        // Premium Delete Confirmation
                        function confirmDelete(id, coinName) {
                            Swal.fire({
                                title: 'Delete Trade?',
                                text: `You are about to remove this trade for ${coinName.toUpperCase()}. This action cannot be undone.`,
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#ff5e5e',
                                cancelButtonColor: '#303030',
                                confirmButtonText: 'Yes, delete it!',
                                background: '#1a1a1a',
                                color: '#ffffff',
                                customClass: {
                                    popup: 'premium-swal-popup',
                                    confirmButton: 'premium-swal-btn error',
                                    cancelButton: 'premium-swal-btn secondary'
                                },
                                backdrop: `rgba(0,0,0,0.6) backdrop-filter(blur(5px))`
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = `/delete?id=${id}&Asset=${coinName}`;
                                }
                            });
                        }

                        // Show add transaction options
                        function showAddTransactionOptions() {
                            Swal.fire({
                                title: 'Investment Action',
                                text: 'How would you like to update your holdings?',
                                icon: 'question',
                                showDenyButton: true,
                                showCancelButton: true,
                                confirmButtonText: '<i class="fas fa-exchange-alt"></i> Buy/Sell Asset',
                                denyButtonText: '<i class="fas fa-wallet"></i> Manage Funding',
                                cancelButtonText: 'Close',
                                customClass: {
                                    popup: 'premium-swal-popup',
                                    confirmButton: 'premium-swal-btn primary',
                                    denyButton: 'premium-swal-btn success',
                                    cancelButton: 'premium-swal-btn secondary'
                                },
                                confirmButtonColor: 'var(--primary-color)',
                                denyButtonColor: 'var(--success-color)'
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = '/portfolio';
                                } else if (result.isDenied) {
                                    window.location.href = '/funding';
                                }
                            });
                        }
                    </script>
    </body>

    </html>