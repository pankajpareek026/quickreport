<%- include('partials/head', { title: 'QuickReport | Cryptocurrency Portfolio Tracker' ,
  description: 'Track your cryptocurrency portfolio with professional analytics and real-time data.' ,
  additionalStyles: '<link rel="stylesheet" href="/css/homePage.css">' }) %>

  <body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>

      <section class="home-hero">
        <div class="fng-hero-card" id="feargreed">
          <div class="fng-dot"></div>
          <span class="fng-text" id="fngName">Market Pulse: Loading...</span>
        </div>

        <h1 class="hero-title">Track Your Crypto<br>Like a Professional</h1>
        <p class="hero-subtitle">The ultimate portfolio tracker for retail investors and whales alike. Secure,
          comprehensive, and entirely free.</p>

        <div class="hero-cta">
          <a href="/register" class="btn btn-primary btn-lg">Start Tracking Now</a>
          <a href="#market-explore" class="btn btn-outline-secondary btn-lg">Explore Market</a>
        </div>

        <!-- Pulse Grid (Market Overviews) -->
        <div class="pulse-grid">
          <div class="pulse-card">
            <div class="pulse-icon"><i class="fas fa-chart-line"></i></div>
            <div class="pulse-info">
              <h4>Market Status</h4>
              <div class="pulse-value">Live Data 24/7</div>
            </div>
          </div>
          <div class="pulse-card">
            <div class="pulse-icon"><i class="fas fa-arrow-trend-up"></i></div>
            <div class="pulse-info">
              <h4>Top Gainer</h4>
              <div class="pulse-value text-success" id="gainDisplay">--</div>
            </div>
          </div>
          <div class="pulse-card">
            <div class="pulse-icon"><i class="fas fa-arrow-trend-down"></i></div>
            <div class="pulse-info">
              <h4>Top Loser</h4>
              <div class="pulse-value text-error" id="lossDisplay">--</div>
            </div>
          </div>
        </div>
      </section>

      <div class="market-pulse" id="market-explore">
        <!-- Search & Filter Container -->
        <div class="landing-search-container">
          <div class="search-main">
            <i class="fas fa-search"></i>
            <input type="search" id="search" class="premium-search-input" placeholder="Search any cryptocurrency..."
              list="coinId" autocomplete="off">
          </div>

          <select id="currency" class="premium-select" title="Select Currency">
            <option value="usd">USD</option>
            <option value="eur">EUR</option>
            <option value="inr">INR</option>
          </select>

          <button id="submitID" class="btn btn-primary" style="height: 60px; border-radius: 15px; padding: 0 30px;">
            Find Coin
          </button>

          <datalist id="coinId"></datalist>
        </div>

        <!-- Main Market Table -->
        <div class="landing-table-container">
          <table id="MainTable" class="premium-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Coin</th>
                <th>Price</th>
                <th>24h Change</th>
                <th>24h Volume</th>
                <th>ATH</th>
                <th>From ATH</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <!-- Injected by JS -->
            </tbody>
          </table>

          <!-- Loading Spinner -->
          <div class="loader-container" id="loader">
            <div class="lds-roller">
              <div></div>
              <div></div>
              <div></div>
              <div></div>
              <div></div>
              <div></div>
              <div></div>
              <div></div>
            </div>
            <p class="loading-text">Synchronizing global market data...</p>
          </div>
        </div>
      </div>

      <%- include('partials/footer') %>
        <%- include('partials/scripts', {
          additionalScripts: '<script src="/js/homePage.js"></script><script src="/js/coins.js"></script>' }) %>

          <script>
            document.addEventListener('DOMContentLoaded', function () {
              initCoinDatalist('coinId');

              // Sync stats to display fields (bridging old logic to new UI)
              const gainInput = document.getElementById('gain');
              const lossInput = document.getElementById('loss');
              const observer = new MutationObserver(() => {
                if (gainInput) document.getElementById('gainDisplay').textContent = gainInput.value;
                if (lossInput) document.getElementById('lossDisplay').textContent = lossInput.value;
              });

              // Start observing once the elements might exist (legacy js might create them)
              const interval = setInterval(() => {
                const g = document.getElementById('gain');
                const l = document.getElementById('loss');
                if (g && l) {
                  document.getElementById('gainDisplay').textContent = g.value;
                  document.getElementById('lossDisplay').textContent = l.value;
                  clearInterval(interval);
                }
              }, 1000);
            });
          </script>
  </body>

  </html>