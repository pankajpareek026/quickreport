<%- include('partials/head', { title: 'QuickReport - Cryptocurrency Portfolio Tracker' ,
  description: 'Track your cryptocurrency portfolio, view real-time prices, and manage your investments' ,
  additionalStyles: '<link rel="stylesheet" href="/css/homePage.css">' }) %>

  <body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>

      <!-- Fear & Greed Index -->
      <div class="fear-greed-index" id="feargreed" title="Fear & Greed Index">
        <p id="fngName">Loading...</p>
      </div>

      <!-- Search Section -->
      <div class="search-section">
        <div class="search-wrapper">
          <input type="search" id="search" class="search-input"
            placeholder="Search any cryptocurrency (e.g., bitcoin, ethereum)" list="coinId" autocomplete="off">
          <button id="submitID" class="search-button" type="button">
            <i class="fas fa-search"></i> Search
          </button>
        </div>

        <select id="currency" class="currency-selector" title="Select Currency">
          <option value="usd">USD</option>
          <option value="eur">EUR</option>
          <option value="gbp">GBP</option>
          <option value="jpy">JPY</option>
          <option value="inr">INR</option>
          <option value="btc">BTC</option>
          <option value="eth">ETH</option>
        </select>

        <datalist id="coinId">
          <!-- Popular coins preloaded, more will be loaded dynamically -->
        </datalist>
      </div>

      <!-- Stats Bar -->
      <div class="stats-bar">
        <div class="stats-item">
          <span class="stats-label">Market Status:</span>
          <span class="stats-label"># OUT OF TOP 250</span>
        </div>
        <div class="stats-item">
          <span class="stats-label">Gainers:</span>
          <input type="text" id="gain" class="stats-input gain" disabled readonly>
        </div>
        <div class="stats-item">
          <span class="stats-label">Losers:</span>
          <input type="text" id="loss" class="stats-input loss" disabled readonly>
        </div>
      </div>

      <!-- Coins Table Container -->
      <div class="coins-table-container">
        <table id="MainTable" class="coins-table">
          <thead>
            <tr>
              <th title="Rank According To Market Capital" class="rank-header">#</th>
              <th>Coin</th>
              <th title="Current Price">Price</th>
              <th title="Price Change In Last 24 Hours">Change (24h)</th>
              <th title="Volume (Buy + Sell)">Volume</th>
              <th title="All Time High">ATH</th>
              <th title="Down From All Time High">From ATH</th>
              <th title="Date Of All Time High">ATH Date</th>
            </tr>
          </thead>
          <tbody>
            <!-- Coins will be dynamically inserted here -->
          </tbody>
        </table>
      </div>

      <!-- Loading Spinner -->
      <div class="loader loading--full-height" id="loader">
        <div class="loading-spinner"></div>
        <p class="loading-text">Loading cryptocurrency data...</p>
      </div>

      <%- include('partials/footer') %>
        <%- include('partials/scripts', {
          additionalScripts: '<script src="/js/homePage.js"></script><script src="/js/coins.js"></script>' }) %>

          <script>
            // Initialize coin datalist with popular coins
            document.addEventListener('DOMContentLoaded', function () {
              initCoinDatalist('coinId');
            });
          </script>
  </body>

  </html>