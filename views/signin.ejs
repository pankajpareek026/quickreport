<%- include('partials/head', { title: 'Join QuickReport' ,
    description: 'Create your free crypto portfolio tracking account.' ,
    additionalStyles: '<link rel="stylesheet" href="/css/auth.css">' }) %>

    <body>
        <%- include('partials/navbar', { isAuthenticated: false }) %>

            <div class="auth-page-wrapper">
                <div class="auth-card">
                    <div class="auth-header">
                        <i class="fas fa-rocket"></i>
                        <h1>Create Account</h1>
                        <p>Start tracking your assets with professional tools</p>
                    </div>

                    <form action="/register" method="post" id="registerForm" class="auth-body">
                        <div class="auth-group">
                            <label for="userName" class="auth-label">
                                <i class="fas fa-at"></i> Username
                            </label>
                            <input type="text" id="userName" name="userName" class="auth-input"
                                placeholder="crypto_whale" required autocomplete="username" minlength="3"
                                maxlength="30">
                        </div>

                        <div class="auth-group">
                            <label for="Name" class="auth-label">
                                <i class="fas fa-user"></i> Full Name
                            </label>
                            <input type="text" id="Name" name="Name" class="auth-input" placeholder="John Doe" required
                                autocomplete="name">
                        </div>

                        <div class="auth-group">
                            <label for="emailId" class="auth-label">
                                <i class="fas fa-envelope"></i> Email Address
                            </label>
                            <input type="email" id="emailId" name="emailId" class="auth-input"
                                placeholder="john@example.com" required autocomplete="email">
                        </div>

                        <div class="auth-group">
                            <label for="password" class="auth-label">
                                <i class="fas fa-shield-alt"></i> Secure Password
                            </label>
                            <input type="password" id="password" name="password" class="auth-input"
                                placeholder="••••••••" required autocomplete="new-password" minlength="6">
                            <p style="color: var(--text-muted); font-size: 0.75rem; margin-top: 5px;">
                                Must be at least 6 characters with mixed case.
                            </p>
                        </div>

                        <button type="submit" class="btn btn-primary auth-btn-long">
                            Start Your Journey
                        </button>

                        <div class="social-login-divider">Joined Us Before?</div>

                        <div class="auth-footer">
                            <p class="auth-support-text">
                                Already have an account?
                                <a href="/login">Login Securely</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>
    </body>

    </html>