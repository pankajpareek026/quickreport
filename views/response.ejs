<%- include('partials/head', { title: 'Success', description: 'Transaction added successfully' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> Transaction Added!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    Your transaction has been successfully added to your portfolio.
                </p>
                <div class="button-group" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center;">
                    <button onclick="window.location='/dash-bord'" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> Go to Dashboard
                    </button>
                    <button onclick="window.location='/portfolio'" class="btn btn-secondary">
                        <i class="fas fa-plus"></i> Add Another
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
