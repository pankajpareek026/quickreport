<%- include('partials/head', { 
    title: 'Upload Trade History', 
    description: 'Upload your cryptocurrency trade history from Binance or KuCoin',
    additionalStyles: '<link rel="stylesheet" href="/css/pages.css">'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container" style="max-width: 600px;">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-file-upload"></i> Upload Trade History
                </h1>
            </div>
            
            <form id="uploadForm" action="/upload" method="post" enctype="multipart/form-data" class="form-body">
                <div class="form-group">
                    <label for="Tfile" class="form-label">
                        <i class="fas fa-file" style="color: var(--primary-color);"></i> Select File (JSON or CSV)
                    </label>
                    <input 
                        type="file" 
                        id="Tfile" 
                        name="Tfile" 
                        class="form-input" 
                        accept=".json,.csv,.JSON,.CSV" 
                        required
                        style="padding: 10px;"
                    >
                    <small style="color: var(--text-muted); font-size: 0.85rem; display: block; margin-top: 5px;">
                        Supported formats: Binance (JSON) or KuCoin (CSV)
                    </small>
                </div>
                
                <div class="form-group" style="margin-top: 25px;">
                    <button type="submit" id="submitBtn" class="btn btn-primary" style="width: 100%;">
                        <i class="fas fa-upload"></i> Upload File
                    </button>
                </div>
            </form>
        </div>
        
        <div class="card" style="margin-top: 30px;">
            <div class="card-header">
                <h3 class="card-title" style="font-size: 1.2rem;">
                    <i class="fas fa-info-circle" style="color: var(--info-color);"></i> Important Notes
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <p style="color: var(--text-primary); font-size: 1rem; line-height: 1.6;">
                        <strong style="color: var(--warning-color);">NOTE:</strong> We currently support:
                    </p>
                    <ul style="color: var(--text-secondary); margin: 10px 0; padding-left: 20px;">
                        <li><strong>Binance Exchange:</strong> JSON file format</li>
                        <li><strong>KuCoin Exchange:</strong> CSV file format</li>
                    </ul>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 10px;">
                        If you upload trade reports from other exchanges, some transactions may be lost. 
                        You may need to reset your portfolio. We are not responsible for data loss from unsupported formats.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        const form = document.getElementById('uploadForm');
        const fileInput = document.getElementById('Tfile');
        const submitBtn = document.getElementById('submitBtn');
        
        form.addEventListener('submit', function(e) {
            const file = fileInput.files[0];
            
            if (!file) {
                e.preventDefault();
                Swal.fire({
                    title: 'File Not Selected!',
                    text: 'Please select a CSV or JSON file to process.',
                    icon: 'warning',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
            
            // Validate file type
            const fileName = file.name.toLowerCase();
            const isValidType = fileName.endsWith('.json') || fileName.endsWith('.csv');
            
            if (!isValidType) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid File Type!',
                    text: 'Please select a valid JSON or CSV file.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
            
            // Show loading state
            submitBtn.innerHTML = '<div class="lds-roller"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>';
            submitBtn.disabled = true;
        });
        
        // File input change handler
        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const fileSizeMB = file.size / (1024 * 1024);
                if (fileSizeMB > 10) {
                    Swal.fire({
                        title: 'File Too Large!',
                        text: 'File size exceeds 10MB limit. Please select a smaller file.',
                        icon: 'error',
                        confirmButtonColor: 'var(--primary-color)'
                    });
                    this.value = '';
                }
            }
        });
    </script>
</body>
</html>
