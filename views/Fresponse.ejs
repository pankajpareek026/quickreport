<%- include('partials/head', { title: 'Transfer Success' , description: 'Transaction recorded successfully' ,
    additionalStyles: '<link rel="stylesheet" href="/css/auth.css"><link rel="stylesheet" href="/css/dashboard.css">' })
    %>

    <style>
        .success-container {
            min-height: calc(100vh - 80px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px 20px;
        }

        .glass-card {
            width: 100%;
            max-width: 500px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 50px 40px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .success-icon {
            width: 80px;
            height: 80px;
            background: rgba(72, 187, 120, 0.1);
            color: var(--success-color);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            margin: 0 auto 30px;
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 40px;
        }

        .btn-premium {
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 1.05rem;
        }

        .btn-primary {
            background: var(--primary-color);
            color: white;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>

    <body>
        <%- include('partials/navbar', { isAuthenticated: true }) %>

            <div class="success-container">
                <div class="glass-card">
                    <div class="success-icon">
                        <i class="fas fa-check"></i>
                    </div>
                    <h1 style="color: var(--text-primary); font-size: 1.8rem; margin-bottom: 10px;">Transfer Confirmed
                    </h1>
                    <p style="color: var(--text-secondary);">Your funding activity has been successfully synced with the
                        terminal.</p>

                    <div class="btn-group">
                        <button onclick="window.location='/dash-bord'" class="btn-premium btn-primary">
                            <i class="fas fa-chart-pie"></i> DASHBOARD
                        </button>
                        <button onclick="window.location='/funding'" class="btn-premium btn-secondary">
                            <i class="fas fa-plus"></i> NEW TRANSFER
                        </button>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>
    </body>

    </html>