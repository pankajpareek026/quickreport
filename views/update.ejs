<%- include('partials/head', { 
    title: 'Update Transaction', 
    description: 'Update your cryptocurrency transaction',
    additionalStyles: '<link rel="stylesheet" href="/css/pages.css">'
}) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container" style="max-width: 600px;">
        <div class="card">
            <div class="card-header text-center">
                <h1 class="card-title">
                    <i class="fas fa-edit"></i> Update Transaction
                </h1>
            </div>
            
            <% if (typeof result !== 'undefined' && result && result.length > 0) { %>
                <form action="/update" method="post" id="updateForm" class="form-body">
                    <input type="hidden" name="id" value="<%= result[0].ID %>">
                    
                    <div class="form-group">
                        <label for="coinName" class="form-label">
                            <i class="fas fa-coins" style="color: var(--primary-color);"></i> Coin Name
                        </label>
                        <div style="display: flex; gap: 0;">
                            <input 
                                type="text" 
                                id="coinName" 
                                name="coinName" 
                                class="coin-name-input" 
                                list="coinList"
                                value="<%= result[0].Coin_Name %>"
                                required
                                autocomplete="off"
                                style="width: 70%; border-radius: 5px 0 0 5px;"
                            >
                            <select 
                                name="ordertype" 
                                id="ordertype" 
                                class="order-type-select"
                                required
                                style="width: 30%; border-radius: 0 5px 5px 0; border-left: 2px solid var(--bg-darker);"
                            >
                                <option value="BUY" <%= result[0].ORDER_TYPE === 'BUY' ? 'selected' : '' %>>BUY</option>
                                <option value="SELL" <%= result[0].ORDER_TYPE === 'SELL' ? 'selected' : '' %>>SELL</option>
                            </select>
                        </div>
                        <datalist id="coinList"></datalist>
                    </div>
                    
                    <div class="form-group">
                        <label for="price" class="form-label">
                            <i class="fas fa-dollar-sign" style="color: var(--primary-color);"></i> Price per Unit
                        </label>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <span id="priceSymbol" style="color: var(--primary-color); font-weight: bold;">$</span>
                            <input 
                                type="number" 
                                id="price" 
                                name="price" 
                                class="form-number-input" 
                                value="<%= result[0].PRICE %>"
                                step="any"
                                required
                                onclick="fetchPrice()"
                                style="flex: 1;"
                            >
                            <button 
                                type="button" 
                                onclick="fetchPrice()" 
                                class="btn btn-secondary"
                                style="padding: 8px 15px;"
                                title="Fetch current price"
                            >
                                <i class="fas fa-sync-alt"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="units" class="form-label">
                            <i class="fas fa-calculator" style="color: var(--primary-color);"></i> Units/Quantity
                        </label>
                        <input 
                            type="number" 
                            id="units" 
                            name="units" 
                            class="form-number-input" 
                            value="<%= Math.abs(result[0].UNITS) %>"
                            step="any"
                            required
                            onkeyup="calculateTotal()"
                            onkeydown="calculateTotal()"
                        >
                    </div>
                    
                    <div class="form-group">
                        <label for="totals" class="form-label">
                            <i class="fas fa-money-bill-wave" style="color: var(--primary-color);"></i> Total Cost
                        </label>
                        <div style="display: flex; align-items: center; gap: 5px;">
                            <span id="totalSymbol" style="color: var(--primary-color); font-weight: bold;">$</span>
                            <input 
                                type="number" 
                                id="totals" 
                                name="totals" 
                                class="form-number-input" 
                                value="<%= result[0].TOTAL_COST || result[0].SELL_COST %>"
                                step="any"
                                required
                                onkeyup="calculateTotal()"
                                style="flex: 1;"
                            >
                        </div>
                    </div>
                    
                    <div class="btns" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 25px;">
                        <button type="reset" class="btn btn-secondary">
                            <i class="fas fa-redo"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Update
                        </button>
                    </div>
                </form>
            <% } else { %>
                <div class="alert alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    Transaction not found. <a href="/dash-bord" style="color: var(--error-color);">Go to Dashboard</a>
                </div>
            <% } %>
        </div>
        
        <div style="text-align: center; margin-top: 20px;">
            <a href="/funding" class="btn btn-success" style="text-decoration: none;">
                <i class="fas fa-wallet"></i> Funding
            </a>
            <a href="/dash-bord" class="btn btn-secondary" style="text-decoration: none; margin-left: 10px;">
                <i class="fas fa-chart-pie"></i> Dashboard
            </a>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts', { 
        additionalScripts: '<script src="/js/coins.js"></script>' 
    }) %>
    
    <script>
        // Initialize coin datalist
        document.addEventListener('DOMContentLoaded', function() {
            initCoinDatalist('coinList');
        });
        
        // Number validation
        function onlyNumberKey(evt) {
            const ASCIICode = (evt.which) ? evt.which : evt.keyCode;
            if (ASCIICode == 46) return true;
            else if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57)) return false;
            return true;
        }
        
        // Fetch price from Binance
        async function fetchPrice() {
            const coinName = document.getElementById('coinName').value.trim().toUpperCase();
            const priceInput = document.getElementById('price');
            
            if (!coinName) {
                Swal.fire({
                    title: 'Coin Name Required!',
                    text: 'Please enter or select a coin name first.',
                    icon: 'warning',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return;
            }
            
            if (!navigator.onLine) {
                Swal.fire({
                    title: 'Offline!',
                    text: 'Please connect to the internet.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return;
            }
            
            try {
                priceInput.disabled = true;
                priceInput.value = 'Fetching...';
                
                const price = await getCoinPrice(coinName);
                
                if (price && price > 0) {
                    priceInput.value = price;
                    calculateTotal();
                } else {
                    throw new Error('Invalid price');
                }
            } catch (error) {
                Swal.fire({
                    title: 'Price Not Found!',
                    text: `Could not fetch price for ${coinName}. Please enter manually.`,
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
            } finally {
                priceInput.disabled = false;
            }
        }
        
        // Calculate total
        function calculateTotal() {
            const price = parseFloat(document.getElementById('price').value) || 0;
            const units = parseFloat(document.getElementById('units').value) || 0;
            const total = price * units;
            
            if (total > 0) {
                const totalInput = document.getElementById('totals');
                if (total < 0.0001) {
                    totalInput.value = total.toFixed(8);
                } else {
                    totalInput.value = total.toFixed(2);
                }
            }
        }
        
        // Auto-calculate
        document.getElementById('price').addEventListener('input', calculateTotal);
        
        // Form validation
        document.getElementById('updateForm').addEventListener('submit', function(e) {
            const coinName = document.getElementById('coinName').value.trim();
            const price = parseFloat(document.getElementById('price').value);
            const units = parseFloat(document.getElementById('units').value);
            const total = parseFloat(document.getElementById('totals').value);
            
            if (!coinName || !price || price <= 0 || !units || units <= 0 || !total || total <= 0) {
                e.preventDefault();
                Swal.fire({
                    title: 'Invalid Data!',
                    text: 'Please fill all fields with valid values.',
                    icon: 'error',
                    confirmButtonColor: 'var(--primary-color)'
                });
                return false;
            }
        });
    </script>
</body>
</html>
