<%- include('partials/head', { title: 'Update Transaction' , description: 'Modify your existing trade records' ,
    additionalStyles: '<link rel="stylesheet" href="/css/auth.css"><link rel="stylesheet" href="/css/dashboard.css">' })
    %>

    <style>
        .update-container {
            min-height: calc(100vh - 80px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 100px 20px 40px;
        }

        .glass-form-card {
            width: 100%;
            max-width: 550px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
        }

        .form-header h2 {
            color: var(--text-primary);
            font-size: 1.8rem;
            margin-bottom: 30px;
            text-align: center;
        }

        .input-row {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
        }

        .input-group {
            margin-bottom: 25px;
            flex: 1;
        }

        .input-group label {
            display: block;
            color: var(--text-secondary);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .premium-input {
            width: 100%;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 18px;
            color: var(--text-primary);
            font-size: 1rem;
            transition: var(--transition);
            outline: none;
        }

        .premium-input:focus {
            border-color: var(--primary-color);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 4px rgba(248, 134, 5, 0.1);
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-top: 20px;
        }

        .btn-premium {
            padding: 14px;
            border-radius: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 1rem;
        }

        .btn-save {
            background: var(--primary-color);
            color: white;
        }

        .btn-save:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.05);
            color: var(--text-secondary);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
        }
    </style>

    <body>
        <%- include('partials/navbar', { isAuthenticated: true }) %>

            <div class="update-container">
                <% if (typeof result !=='undefined' && result && result.length> 0) { %>
                    <div class="glass-form-card">
                        <div class="form-header">
                            <h2><i class="fas fa-edit" style="color: var(--primary-color);"></i> Adjust Transaction</h2>
                        </div>

                        <form action="/update" method="post" id="updateForm">
                            <input type="hidden" name="id" value="<%= result[0].ID %>">

                            <div class="input-row">
                                <div class="input-group" style="flex: 2;">
                                    <label>Asset Name</label>
                                    <input type="text" id="coinName" name="coinName" class="premium-input"
                                        list="coinList" value="<%= result[0].Coin_Name %>" required autocomplete="off">
                                    <datalist id="coinList"></datalist>
                                </div>
                                <div class="input-group" style="flex: 1;">
                                    <label>Order Type</label>
                                    <select name="ordertype" id="ordertype" class="premium-input">
                                        <option value="BUY" <%=result[0].ORDER_TYPE==='BUY' ? 'selected' : '' %>>BUY
                                        </option>
                                        <option value="SELL" <%=result[0].ORDER_TYPE==='SELL' ? 'selected' : '' %>>SELL
                                        </option>
                                    </select>
                                </div>
                            </div>

                            <div class="input-group">
                                <label>Execution Price (USD)</label>
                                <div style="position: relative;">
                                    <input type="number" id="price" name="price" class="premium-input"
                                        value="<%= result[0].PRICE %>" step="any" required>
                                    <button type="button" onclick="fetchPrice()"
                                        style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: var(--primary-color); border: none; border-radius: 8px; color: white; padding: 6px 10px; cursor: pointer;">
                                        <i class="fas fa-sync-alt"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="input-group">
                                <label>Units / Quantity</label>
                                <input type="number" id="units" name="units" class="premium-input"
                                    value="<%= Math.abs(result[0].UNITS) %>" step="any" required
                                    oninput="calculateTotal()">
                            </div>

                            <div class="input-group">
                                <label>Settlement Amount (USD)</label>
                                <input type="number" id="totals" name="totals" class="premium-input"
                                    value="<%= result[0].TOTAL_COST || result[0].SELL_COST %>" step="any" required
                                    oninput="calculateTotal()" style="background: rgba(0,0,0,0.2);">
                            </div>

                            <div class="btn-group">
                                <a href="/dash-bord" class="btn-premium btn-cancel">Cancel</a>
                                <button type="submit" class="btn-premium btn-save">
                                    <i class="fas fa-save"></i> Save Changes
                                </button>
                            </div>
                        </form>
                    </div>
                    <% } else { %>
                        <div class="glass-form-card" style="text-align: center;">
                            <i class="fas fa-exclamation-triangle fa-3x"
                                style="color: var(--error-color); margin-bottom: 20px;"></i>
                            <h2 style="color: var(--text-primary);">Record Not Found</h2>
                            <a href="/dash-bord" class="btn-premium btn-save">Return to Dashboard</a>
                        </div>
                        <% } %>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts', { additionalScripts: '<script src="/js/coins.js"></script>' }) %>

                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            initCoinDatalist('coinList');
                        });

                        async function fetchPrice() {
                            const coinName = document.getElementById('coinName').value.trim();
                            const priceInput = document.getElementById('price');

                            if (!coinName) return;

                            try {
                                priceInput.style.opacity = '0.5';
                                const price = await getCoinPrice(coinName);
                                if (price) {
                                    priceInput.value = price;
                                    calculateTotal();
                                }
                            } catch (e) {
                                console.error(e);
                            } finally {
                                priceInput.style.opacity = '1';
                            }
                        }

                        function calculateTotal() {
                            const price = parseFloat(document.getElementById('price').value) || 0;
                            const units = parseFloat(document.getElementById('units').value) || 0;
                            const totalInput = document.getElementById('totals');
                            totalInput.value = (price * units).toFixed(2);
                        }
                    </script>
    </body>

    </html>