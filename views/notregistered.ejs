<%- include('partials/head', { title: 'Login Failed', description: 'Invalid credentials' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-error">
                    <i class="fas fa-times-circle"></i> Login Failed
                </h1>
            </div>
            <div class="card-body">
                <p class="alert-message" style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    Invalid username or password. Please try again.
                </p>
                <div class="button-group" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center;">
                    <a href="/login" class="btn btn-primary">
                        <i class="fas fa-sign-in-alt"></i> Try Again
                    </a>
                    <a href="/register" class="btn btn-secondary">
                        <i class="fas fa-user-plus"></i> Register
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
