<%- include('partials/head', { title: 'Upload Success', description: 'File uploaded and processed successfully' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> File Processed!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    File <strong style="color: var(--primary-color);"><%= typeof file !== 'undefined' ? file : 'uploaded file' %></strong> has been processed successfully.
                </p>
                <p style="font-size: 1rem; margin: 20px 0; color: var(--primary-color);">
                    <strong><%= typeof transactions !== 'undefined' ? transactions : 0 %></strong> transactions have been added to your portfolio.
                </p>
                <div class="button-group" style="margin-top: 30px; display: flex; gap: 10px; justify-content: center;">
                    <button onclick="window.location='/dash-bord'" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> View Dashboard
                    </button>
                    <button onclick="window.location='/upload'" class="btn btn-secondary">
                        <i class="fas fa-upload"></i> Upload Another
                    </button>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
