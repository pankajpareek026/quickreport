<%- include('partials/head', { title: 'Dashboard | QuickReport' ,
    description: 'Track your crypto portfolio with premium analytics' ,
    additionalStyles: '<link rel="stylesheet" href="/css/dashboard.css">' }) %>

    <style>
        .glass-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            padding: 25px;
            transition: var(--transition);
        }

        .glass-card:hover {
            transform: translateY(-3px);
            border-color: var(--primary-color);
        }

        .holdings-table {
            width: 100%;
            border-collapse: collapse;
        }

        .holdings-table th {
            color: var(--text-secondary);
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1.5px;
            padding: 20px;
            text-align: left;
        }

        .holdings-table td {
            padding: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .gain-pill {
            background: rgba(72, 187, 120, 0.1);
            color: var(--success-color);
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
        }

        .loss-pill {
            background: rgba(245, 101, 101, 0.1);
            color: var(--error-color);
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.85rem;
        }
    </style>

    <body>
        <%- include('partials/navbar', { isAuthenticated: true }) %>

            <div class="dashboard-container">
                <div class="dashboard-header" style="margin-bottom: 40px;">
                    <div class="welcome-section">
                        <h1 class="welcome-title">Wealth Overview</h1>
                        <p class="welcome-subtitle">Managed by QuickReport Terminal</p>
                    </div>
                    <div class="header-actions">
                        <button class="premium-btn primary" onclick="ShowOptions()">
                            <i class="fas fa-plus-circle"></i> NEW RECORD
                        </button>
                        <button class="premium-btn secondary" onclick="ConfirmDelete()">
                            <i class="fas fa-undo"></i> RESET
                        </button>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid">
                    <div class="glass-card stat-card">
                        <span class="stat-label"><i class="fas fa-wallet" style="color: var(--primary-color);"></i> Net
                            Worth</span>
                        <h3 class="stat-value" id="portfolioValueDisplay">
                            $<%= portValue.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2
                                }) %>
                        </h3>
                        <div class="stat-trend <%= Current_Value >= 0 ? 'up' : 'down' %>">
                            <i class="fas <%= Current_Value >= 0 ? 'fa-caret-up' : 'fa-caret-down' %>"></i>
                            <%= invested> 0 ? Math.abs(parseFloat(((Current_Value) / invested) * 100)).toFixed(2) :
                                '0.00' %>%
                        </div>
                    </div>

                    <div class="glass-card stat-card">
                        <span class="stat-label"><i class="fas fa-hand-holding-usd" style="color: #4cd964;"></i> Cost
                            Basis</span>
                        <h3 class="stat-value" id="investedValueDisplay">
                            $<%= parseFloat(invested || 0).toLocaleString('en-US', { minimumFractionDigits: 2,
                                maximumFractionDigits: 2 }) %>
                        </h3>
                        <span class="stat-meta">
                            <%= results.length %> Global Assets
                        </span>
                        <button class="eye-toggle" id="eye" onclick="Secure()" title="Toggle Privacy Mode">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>

                    <div class="glass-card stat-card">
                        <span class="stat-label"><i class="fas fa-chart-line" style="color: #5ac8fa;"></i> Total
                            Returns</span>
                        <h3 class="stat-value <%= Current_Value >= 0 ? 'gain' : 'loss' %>" id="totalPnlDisplay">
                            <%= Current_Value>= 0 ? '+' : '-' %>$<%= Math.abs(parseFloat(Current_Value ||
                                    0)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                                    %>
                        </h3>
                        <span class="stat-meta">Lifetime Portfolio P&L</span>
                    </div>
                </div>

                <!-- Asset Portfolio -->
                <div class="glass-card" style="padding: 0; overflow: hidden;">
                    <div
                        style="padding: 25px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                        <h2 style="font-size: 1.2rem; display: flex; align-items: center; gap: 10px;">
                            <i class="fas fa-layer-group" style="color: var(--primary-color);"></i> Asset Portfolio
                        </h2>
                    </div>

                    <div class="table-responsive">
                        <table class="holdings-table">
                            <thead>
                                <tr>
                                    <th>Asset</th>
                                    <th>Quantity</th>
                                    <th>Avg. Cost</th>
                                    <th>Returns</th>
                                    <th>Settlement</th>
                                    <th style="text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(results.length> 0) { %>
                                    <% for(var i=0; i < results.length; i++) { %>
                                        <tr>
                                            <td>
                                                <div style="display: flex; align-items: center; gap: 12px;">
                                                    <div
                                                        style="width: 32px; height: 32px; background: rgba(248, 134, 5, 0.1); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: var(--primary-color);">
                                                        <i class="fas fa-coins"></i>
                                                    </div>
                                                    <span style="font-weight: 700; color: var(--text-primary);">
                                                        <%= results[i].Coin_Name.toUpperCase() %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td style="font-family: 'Roboto Mono', monospace;">
                                                <%= parseFloat(results[i].TU).toFixed(4) %>
                                            </td>
                                            <td style="font-family: 'Roboto Mono', monospace;">$<%=
                                                    parseFloat(results[i].TC - results[i].SC).toFixed(2) %>
                                            </td>
                                            <td>
                                                <span class="<%= Dpnl[i] >= 0 ? 'gain-pill' : 'loss-pill' %>">
                                                    <%= Dpnl[i]>= 0 ? '+' : '' %><%= Ppnl[i] %>%
                                                </span>
                                            </td>
                                            <td class="<%= Dpnl[i] >= 0 ? 'gain' : 'loss' %>"
                                                style="font-family: 'Roboto Mono', monospace;">
                                                <%= Dpnl[i]>= 0 ? '+' : '' %>$<%=
                                                        Math.abs(parseFloat(Dpnl[i])).toLocaleString() %>
                                            </td>
                                            <td style="text-align: right;">
                                                <a href="/Transactions?Asset=<%= results[i].Coin_Name %>"
                                                    class="icon-btn" title="Inspect Asset">
                                                    <i class="fas fa-arrow-right"></i>
                                                </a>
                                            </td>
                                        </tr>
                                        <% } %>
                                            <% } else { %>
                                                <tr>
                                                    <td colspan="6"
                                                        style="padding: 100px; text-align: center; color: var(--text-secondary);">
                                                        <i class="fas fa-briefcase fa-3x"
                                                            style="opacity: 0.2; margin-bottom: 20px;"></i>
                                                        <p>Your portfolio is empty. Start by adding your first asset.
                                                        </p>
                                                    </td>
                                                </tr>
                                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Funding Section -->
                <div class="dashboard-table-card funding-section"
                    style="margin-top: 40px; background: rgba(255, 255, 255, 0.02); border-radius: 20px;">
                    <div style="padding: 25px; display: flex; justify-content: space-between; align-items: center;">
                        <h2 class="section-title"><i class="fas fa-history"></i> Wallet Activity</h2>
                        <a href="/funding"
                            style="color: var(--primary-color); font-size: 0.85rem; font-weight: 700; text-decoration: none;">VIEW
                            ALL</a>
                    </div>
                    <div class="activity-list">
                        <% if( fundingResult.length> 0 ){ %>
                            <% for(var i=0 ;i < Math.min(fundingResult.length, 5); i++){ %>
                                <div class="activity-item" style="border-bottom: 1px solid rgba(255, 255, 255, 0.03);">
                                    <div style="display: flex; align-items: center; gap: 15px;">
                                        <div class="activity-icon <%= fundingResult[i].amount > 0 ? 'deposit' : 'withdraw' %>"
                                            style="width: 40px; height: 40px; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                                            <i
                                                class="fas <%= fundingResult[i].amount > 0 ? 'fa-arrow-down' : 'fa-arrow-up' %>"></i>
                                        </div>
                                        <div>
                                            <div class="activity-type" style="font-weight: 700;">
                                                <%= fundingResult[i].amount> 0 ? 'Deposit' : 'Withdraw' %>
                                            </div>
                                            <div class="activity-date" style="font-size: 0.75rem;">
                                                <%= fundingResult[i].date %>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="activity-amount <%= fundingResult[i].amount > 0 ? 'gain' : 'loss' %>"
                                        style="font-family: 'Roboto Mono', monospace; font-weight: 700;">
                                        <%= fundingResult[i].amount> 0 ? '+' : '-' %>$<%=
                                                Math.abs(parseFloat(fundingResult[i].amount)).toFixed(2) %>
                                    </div>
                                </div>
                                <% } %>
                                    <% } else { %>
                                        <div
                                            style="text-align: center; padding: 40px; color: var(--text-secondary); opacity: 0.5;">
                                            <p>No wallet activity recorded.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
                <%- include('partials/scripts') %>

                    <script>
                        async function Secure() {
                            const display = document.getElementById('investedValueDisplay');
                            const portDisplay = document.getElementById('portfolioValueDisplay');
                            const pnlDisplay = document.getElementById('totalPnlDisplay');
                            const eye = document.getElementById('eye').querySelector('i');

                            if (display.textContent.includes('*')) {
                                display.textContent = '$<%= parseFloat(invested || 0).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>';
                                portDisplay.textContent = '$<%= portValue.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>';
                                pnlDisplay.textContent = '<%= Current_Value >= 0 ? "+" : "-" %>$<%= Math.abs(parseFloat(Current_Value || 0)).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>';
                                eye.className = 'fas fa-eye';
                            } else {
                                display.textContent = '$****';
                                portDisplay.textContent = '$****';
                                pnlDisplay.textContent = '****';
                                eye.className = 'fas fa-eye-slash';
                            }
                        }

                        function ConfirmDelete() {
                            Swal.fire({
                                title: 'Reset Portfolio?',
                                text: "This will permanently delete all your transaction and funding data!",
                                icon: 'warning',
                                showCancelButton: true,
                                confirmButtonColor: '#f88605',
                                cancelButtonColor: '#303030',
                                confirmButtonText: 'Yes, reset it!',
                                background: '#1a1a1a',
                                color: '#ffffff',
                                customClass: {
                                    popup: 'premium-swal-popup',
                                    confirmButton: 'premium-swal-btn',
                                    cancelButton: 'premium-swal-btn'
                                }
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = '/reset';
                                }
                            });
                        }

                        function ShowOptions() {
                            Swal.fire({
                                title: 'New Transaction',
                                text: "Choose the record type",
                                icon: 'question',
                                showCancelButton: true,
                                showDenyButton: true,
                                confirmButtonColor: '#48bb78',
                                denyButtonColor: '#f88605',
                                cancelButtonColor: '#303030',
                                confirmButtonText: '<i class="fas fa-shopping-cart"></i> Buy/Sell Asset',
                                denyButtonText: '<i class="fas fa-wallet"></i> Deposit/Withdraw',
                                background: '#1a1a1a',
                                color: '#ffffff',
                                customClass: {
                                    popup: 'premium-swal-popup',
                                    confirmButton: 'premium-swal-btn',
                                    denyButton: 'premium-swal-btn',
                                    cancelButton: 'premium-swal-btn'
                                }
                            }).then((result) => {
                                if (result.isConfirmed) {
                                    window.location.href = '/portfolio';
                                } else if (result.isDenied) {
                                    window.location.href = '/funding';
                                }
                            });
                        }
                    </script>
    </body>

    </html>