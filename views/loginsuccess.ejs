<%- include('partials/head', { title: 'Login Success', description: 'Login successful' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: true }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> Login Successful!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    Welcome back, <strong style="color: var(--primary-color);"><%= typeof name !== 'undefined' ? name : 'User' %></strong>!
                </p>
                <% if (typeof Ustatus !== 'undefined' && !Ustatus) { %>
                    <div class="alert alert-warning" style="margin: 20px 0;">
                        <i class="fas fa-exclamation-triangle"></i>
                        Please verify your email address to access all features.
                        <a href="/emailvarification" style="color: var(--warning-color); text-decoration: underline;">
                            Verify Now
                        </a>
                    </div>
                <% } %>
                <div class="button-group" style="margin-top: 30px;">
                    <a href="/dash-bord" class="btn btn-primary">
                        <i class="fas fa-chart-pie"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    
    <script>
        // Auto-redirect to dashboard after 3 seconds
        setTimeout(() => {
            window.location.href = '/dash-bord';
        }, 3000);
    </script>
</body>
</html>
