<%- include('partials/head', { title: 'Registration Success', description: 'Registration completed successfully' }) %>

<body>
    <%- include('partials/navbar', { isAuthenticated: false }) %>
    
    <div class="form-container text-center">
        <div class="card">
            <div class="card-header">
                <h1 class="card-title text-success">
                    <i class="fas fa-check-circle"></i> Registration Successful!
                </h1>
            </div>
            <div class="card-body">
                <p style="font-size: 1.1rem; margin: 20px 0; color: var(--text-secondary);">
                    Welcome, <strong style="color: var(--primary-color);"><%= typeof name !== 'undefined' ? name : 'User' %></strong>!<br>
                    Your account has been created successfully.
                </p>
                <p style="font-size: 0.9rem; margin: 20px 0; color: var(--text-muted);">
                    Please verify your email address to complete the registration process.
                </p>
                <div class="button-group" style="margin-top: 30px;">
                    <a href="/emailvarification" class="btn btn-primary">
                        <i class="fas fa-envelope"></i> Verify Email
                    </a>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
</body>
</html>
