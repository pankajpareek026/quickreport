# ============================================
# QuickReport - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================
# Server Configuration
# ============================================
# Port number for the Express server
PORT=7000

# Session secret for Express sessions (use a strong random string)
SESSION_SECRET=your_secure_session_secret_here

# ============================================
# Database Configuration (MongoDB)
# ============================================
# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/quickreport
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/quickreport
MONGODB_URI=mongodb://localhost:27017/quickreport

# ============================================
# Authentication & Security
# ============================================
# JWT secret for token signing (use a strong random string)
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_here

# ============================================
# Email Configuration (Nodemailer)
# ============================================
# Gmail account for sending verification emails
# Note: Use App Password, not your regular Gmail password
# Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ============================================
# Cloudinary Configuration (File Uploads)
# ============================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# Optional: External APIs
# ============================================
# CoinMarketCap API Key (optional, for additional market data)
# Get from: https://coinmarketcap.com/api/
CMC_API_KEY=your_coinmarketcap_api_key


